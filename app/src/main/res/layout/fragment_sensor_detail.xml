<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tool="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg">

    <include
        android:id="@+id/header"
        layout="@layout/layout_header" />

    <TextView
        android:id="@+id/tv_sensor_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/header"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:drawableStart="@drawable/ic_grey_door"
        android:gravity="center"
        android:textAlignment="center"
        android:theme="@style/MediumText"
        tool:text="Door Sensor 1" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/sensorTitleWrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@+id/tv_sensor_title"
        android:layout_centerHorizontal="true"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp">

        <EditText
            android:id="@+id/et_sensor_title"
            style="@style/LightEditText"
            android:maxLength="50"
            android:maxLines="2"
            android:textAlignment="center"
            android:theme="@style/LightEditTextTheme"
            android:visibility="invisible" />

    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:id="@+id/ll_sensor_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_sensor_icon"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_grey_door" />

        <TextView
            android:id="@+id/tv_sensor_code_display"
            style="@style/MediumText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:textColor="@color/white" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="20dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_sensor_history"
                style="@style/LockDetailButton"
                android:layout_gravity="top"
                android:drawableTop="@mipmap/ic_history"
                android:text="@string/iv_history"
                android:visibility="visible" />
        </LinearLayout>

        <View
            style="@style/Divider"
            android:layout_marginBottom="10dp"
            android:layout_marginEnd="40dp"
            android:layout_marginStart="40dp"
            android:layout_marginTop="20dp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="30dp"
            android:layout_marginStart="30dp">

            <TextView
                android:id="@+id/lblBatteryLabel"
                style="@style/MediumText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:textColor="@color/dark_gray"
                android:text="@string/sensor_battery"
                android:visibility="visible"/>

            <TextView
                android:id="@+id/tv_sensor_battery"
                style="@style/MediumText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@mipmap/ic_battery_full"
                android:gravity="center"
                android:textColor="@color/dark_gray"
                android:layout_below="@id/lblBatteryLabel"
                android:visibility="visible"/>

            <TextView
                android:id="@+id/tv_factory_reset"
                style="@style/MediumText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:drawableStart="@mipmap/ic_factory_reset"
                android:gravity="center"
                android:text="@string/factory_reset"
                android:textColor="@color/dark_gray"
                android:layout_below="@id/lblBatteryLabel"
                android:visibility="visible"/>

        </RelativeLayout>

    </LinearLayout>

</RelativeLayout>
